+// Cores that can show the whole picture white when asked (a bit of the joystick_3 word), which is what the beacon in lightgun_crt.h needs. The
+// app must not ask a core that cannot do it: it would then hear "no light" and call every shot a reload. LIGHTGUN_CRT_BEACON=0 turns it off.
+static bool crtgun_beacon_core(void)
+{
+	static const char *const cores[] = { "Model2" };
+	if (!cfg.lightgun_crt_beacon) return false;
+	const char *c = user_io_get_core_name(1);
+	for (unsigned k = 0; k < sizeof(cores) / sizeof(*cores); k++) if (!strcasecmp(c, cores[k])) return true;
+	return false;
+}
