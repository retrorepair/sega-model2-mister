+// The beacon's two outputs: the flash request (a level, joystick_3 bit 0) and the trigger, which the app holds back until the aim is known.
+static bool crtgun_bc_req_sent[NUMDEV];
+
+static void crtgun_give_trigger(int i, bool down)
+{
+	struct input_event e;
+	struct input_absinfo ai;
+	memset(&e, 0, sizeof(e));
+	memset(&ai, 0, sizeof(ai));
+	e.type = EV_KEY;
+	e.code = GUNCON2_TRIGGER_CODE;
+	e.value = down ? 1 : 0;
+	input_cb(&e, &ai, i);
+}
+
+static void crtgun_beacon_apply(int i, const crtgun_params *p)
+{
+	bool req = p->beacon && crtgun[i].bc_req;
+	if (req != crtgun_bc_req_sent[i])
+	{
+		user_io_joystick_word(3, req ? 1u : 0u);
+		crtgun_bc_req_sent[i] = req;
+	}
+	if (!p->beacon) return;
+	if (crtgun[i].bc_ev_release) { crtgun[i].bc_ev_release = false; crtgun_give_trigger(i, false); }
+	if (crtgun[i].bc_ev_press)   { crtgun[i].bc_ev_press = false;   crtgun_give_trigger(i, true); }
+}
+
+// True if this event is the trigger of a gun whose trigger the beacon holds back (the tracker has already been given it).
+static bool crtgun_beacon_holds(int i, const struct input_event *ev)
+{
+	if (!cfg.lightgun_crt_tracker || ev->type != EV_KEY || ev->code != GUNCON2_TRIGGER_CODE) return false;
+	if (mapping || user_io_osd_is_visible() || !crtgun_beacon_core()) return false;
+	return input[i].quirk == QUIRK_LIGHTGUN_CRT;
+}
